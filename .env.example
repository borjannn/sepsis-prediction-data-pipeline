# Copy to .env and change the passwords. .env is gitignored.

# --- database (docker-compose reads these too) ---
POSTGRES_HOST=localhost
# change to 5433 if a local Postgres already uses 5432
POSTGRES_PORT=5432
POSTGRES_DB=sepsis_dw
POSTGRES_USER=etl_writer
POSTGRES_PASSWORD=change-me
DM_READER_PASSWORD=change-me-too

# --- pipeline ---
DATA_DIR=./data
EXPORT_DIR=./exports
EXTRACT_WORKERS=16
SPLIT_SEED=42
SPLIT_VERSION=1
# default for --sample
SAMPLE_SIZE=400

# --- dbt (only needed when running dbt directly; the sepsis CLI sets it itself) ---
DBT_PROFILES_DIR=./dbt/sepsis_dw
